# Copy to .env to override defaults. Everything works without this file.
APP_ENV=local
LOG_LEVEL=info
# SQLite file; keep it under ./data so it survives upgrades.
DB_PATH=data/app.db
# Encrypts the Jira token at rest. Needed only to connect Jira; demo tasks work without it.
# Generate one: openssl rand -base64 32. Changing it means entering the token again.
DRAWHL_SECRET_KEY=
# TLS to Jira: set a CA bundle path for a corporate CA, or false to skip verification.
JIRA_TLS_VERIFY=true
JIRA_CA_BUNDLE=
